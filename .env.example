# ============================================
# WorkSphere — Environment Configuration
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://worksphere:worksphere_pass@localhost:5432/worksphere?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Stripe (Phase 5)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Logging
LOG_LEVEL=debug